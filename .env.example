# OpenAI-compatible LLM API. Copy this file to .env and fill in your own key.
# Never commit .env.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional shared password for a public deployment. Requires HTTPS.
# Leave ACCESS_PASSWORD unset for local use. Username defaults to "wordhelper".
# ACCESS_PASSWORD=change-this-password
# ACCESS_USERNAME=wordhelper
